public class AccountsSelector extends fflib_SObjectSelector {
    
    /**
     * Define the standard list of fields to be included in all queries 
     * generated by this selector.
     */
    public List<Schema.SObjectField> getSObjectFieldList() {
        return new List<Schema.SObjectField> {
            Account.Id,
            Account.Name,
            Account.Description,
            Account.AnnualRevenue
        };
    }

    /**
     * Identify the SObject type this selector is responsible for.
     */
    public Schema.SObjectType getSObjectType() {
        return Account.sObjectType;
    }

    /**
     * Custom selector method to retrieve Account records by a set of IDs.
     * It leverages the base class selectSObjectsById method.
     */
    public List<Account> selectById(Set<Id> idSet) {
        return (List<Account>) selectSObjectsById(idSet);
    }
}